# Backend environment variables (copy to .env)

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
# Option 1: Local MongoDB
# MONGODB_URI=mongodb://localhost:27017/npw

# Option 2: MongoDB Atlas (recommended for production)
MONGO_ATLAS_UNAME=your_mongodb_username
MONGO_ATLAS_PWD=your_mongodb_password
MONGODB_URI=mongodb+srv://your_username:your_password@your-cluster.mongodb.net/?appName=your-cluster

# Authentication (Required)
# Generate a long random value (32+ bytes). Do NOT commit the real secret.
JWT_SECRET=change_me_to_a_long_random_string

# Web Push (VAPID) - Required for admin notifications
# Generate keys: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@nexuspcworld.local

# Email Configuration (Required for password reset, order confirmations)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_specific_password
EMAIL_FROM_NAME=Nexus PC World

# Frontend URL (Required for CORS and email links)
FRONTEND_URL=http://localhost:3000
